DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
RETENTION_DAYS=90
STORAGE_LOCAL_PATH=.storage/recordings
# whisper (local, default) or huawei (Cloud SIS; requires the block below).
SPEECH_PROVIDER=whisper
WHISPER_MODEL=small
# Huawei Cloud. The OBS bucket and SIS must live in the same region.
HUAWEI_REGION=
HUAWEI_PROJECT_ID=
HUAWEI_AK=
HUAWEI_SK=
HUAWEI_OBS_BUCKET=
HUAWEI_SIS_PROPERTY=chinese_16k_conversation
# Optional endpoint overrides; derived from HUAWEI_REGION when empty.
HUAWEI_SIS_ENDPOINT=
HUAWEI_OBS_ENDPOINT=
HUAWEI_SIS_POLL_SECONDS=5
HUAWEI_SIS_TIMEOUT_SECONDS=3600
WORKER_POLL_SECONDS=5
